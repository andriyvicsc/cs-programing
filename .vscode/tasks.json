{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++-15 build and run active file",
            "command": "/usr/bin/g++-15",
            "args": [
                "-std=c++20",
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "&&",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiled with g++-15 (C++20) and executed automatically."
        }
    ],
    "version": "2.0.0"
}